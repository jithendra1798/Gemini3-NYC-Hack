# ── CineSnap Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Google Gemini / Veo API key (required)
GEMINI_API_KEY=your-api-key-here

# Dev mode: true = fast models (less rate-limited), false = full quality for demos
DEV_MODE=true

# Test mode: true = skips all Gemini/Veo calls, replays a pre-baked demo video
# Drop your demo video at outputs/finals/test_demo.mp4, then set TEST_MODE=true
# TEST_VIDEO_PATH lets you override the demo video location (default shown below)
TEST_MODE=false
# TEST_VIDEO_PATH=outputs/finals/test_demo.mp4

# Model overrides (optional — defaults shown)
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash
VEO_MODEL=veo-3.1-generate-preview
VEO_FAST_MODEL=veo-3.1-fast-generate-preview

# Pipeline defaults (optional)
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_DURATION_TARGET=30
MAX_PHOTOS=10
VEO_POLL_INTERVAL=10
CROSSFADE_DURATION=0.5

# Server
HOST=0.0.0.0
PORT=8000
